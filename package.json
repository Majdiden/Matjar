{
  "name": "matjar",
  "version": "1.0.0",
  "main": "index.js",
  "type": "module",
  "workspaces": [
    "storefront-themes/_shared",
    "storefront-themes/*",
    "dashboard"
  ],
  "scripts": {
    "start": "node ./index.js",
    "dev:api": "nodemon ./index.js",
    "dev:dashboard": "cd dashboard && npm run dev",
    "build:dashboard": "npm ci --include=dev && npm run build --workspace dashboard",
    "dev:platform-admin": "cd platform-admin && npm run dev",
    "build:platform-admin": "cd platform-admin && npm ci --include=dev && npm run build",
    "dev": "echo 'Run npm run dev:api (backend) and npm run dev:dashboard (frontend) in separate terminals'",
    "create-theme": "node scripts/create-theme.mjs",
    "build-themes": "bash scripts/build-themes.sh",
    "validate-theme": "node scripts/validate-theme.js",
    "dev:mock": "node scripts/dev-mock.mjs",
    "worker": "node ./workers/index.js",
    "migrate": "node scripts/migrate.js up",
    "migrate:down": "node scripts/migrate.js down",
    "migrate:status": "node scripts/migrate.js status",
    "migrate:create": "node scripts/migrate.js create",
    "migrate:production": "node scripts/migrate.js up --production",
    "backup:verify": "node scripts/verify-backup.js",
    "test": "node --test --test-concurrency=1 --test-force-exit tests/**/*.test.js",
    "test:smoke": "node --test --test-concurrency=1 --test-force-exit tests/smoke/**/*.test.js",
    "test:unit": "node --test --test-concurrency=1 --test-force-exit tests/unit/**/*.test.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1032.0",
    "@aws-sdk/lib-storage": "^3.1032.0",
    "@sentry/node": "^10.49.0",
    "@simplewebauthn/server": "^13.3.2",
    "axios": "^1.13.2",
    "bcrypt": "^6.0.0",
    "bullmq": "^5.73.5",
    "cloudinary": "^1.41.3",
    "connect-redis": "^9.0.0",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^8.1.0",
    "express-session": "^1.18.2",
    "form-data": "^4.0.5",
    "helmet": "^8.1.0",
    "hpp": "^0.2.3",
    "jsonwebtoken": "^9.0.2",
    "lru-cache": "^10.2.2",
    "mongoose": "^8.4.4",
    "morgan": "^1.10.1",
    "multer": "^2.0.2",
    "multer-storage-cloudinary": "^4.0.0",
    "nodemon": "^3.1.4",
    "rate-limit-redis": "^4.3.1",
    "redis": "^5.10.0",
    "resend": "^6.5.2",
    "sanitize-html": "^2.17.5",
    "sharp": "^0.34.5",
    "stripe": "^22.0.1",
    "uuid": "^13.0.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "mongodb-memory-server": "^11.0.1",
    "supertest": "^7.2.2"
  }
}
