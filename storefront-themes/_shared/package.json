{
  "name": "@matjar/theme-shared",
  "version": "2.0.0",
  "private": true,
  "description": "Matjar storefront theme SDK — shared runtime, pages, components, hooks, i18n and build tooling consumed by every theme via npm workspaces.",
  "type": "module",
  "main": "./index.ts",
  "exports": {
    ".": "./index.ts",
    "./i18n": "./i18n/index.ts",
    "./i18n/*": "./i18n/*",
    "./pages/*": "./pages/*",
    "./theme/*": "./theme/*",
    "./components/sections": "./components/sections/index.tsx",
    "./components/*": "./components/*",
    "./contexts/*": "./contexts/*",
    "./hooks/*": "./hooks/*",
    "./api/*": "./api/*",
    "./types/*": "./types/*",
    "./build/*": "./build/*",
    "./utils/*": "./utils/*",
    "./*": "./*"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18",
    "react-router-dom": ">=6",
    "i18next": ">=26",
    "react-i18next": ">=17",
    "i18next-browser-languagedetector": ">=8"
  },
  "devDependencies": {
    "@types/react": "^18.3.3"
  }
}
