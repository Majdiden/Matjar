# Server Configuration
PORT=3000
NODE_ENV=development

# Database Configuration (single shared database)
DB_URI=mongodb+srv://username:password@cluster.mongodb.net/matjar?retryWrites=true&w=majority

# Redis
REDIS_URL=redis://localhost:6379

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-this-in-production
JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d

# Password Hashing
BCRYPT_SALT_ROUNDS=10

# CORS Configuration
CORS_ORIGIN=*

# Domain Configuration
DOMAIN_SUFFIX=matjar.com
BASE_DOMAIN=matjar.com

# Custom domain DNS target — merchants point their CNAME / A records
# at these values. Leave empty in dev to skip DNS target verification
# (state machine auto-advances).
#
# PLATFORM_EDGE_CNAME  What merchants CNAME their custom subdomain
#                      hostnames to. On Render this is typically the
#                      web service's `<name>.onrender.com` hostname,
#                      or a branded edge CNAME (e.g.
#                      `edge.matjar.com`) that is itself CNAMEd to
#                      Render. This value is surfaced to merchants
#                      in the custom-domain add dialog, so it must
#                      be publicly resolvable.
# PLATFORM_EDGE_IP     A-record targets (comma-separated) for apex
#                      custom domains. Only needed if you support
#                      root-domain custom hostnames; leave empty
#                      otherwise.
PLATFORM_EDGE_CNAME=edge.matjar.com
PLATFORM_EDGE_IP=

# SSL provider for custom domains.
#   stub       — fake issuance, default for dev/tests. Never use in prod.
#   cloudflare — Cloudflare for SaaS / Custom Hostnames (requires
#                CLOUDFLARE_* below). Certificates are issued and
#                renewed at the Cloudflare edge; we only call the
#                custom-hostname API to register/revoke hostnames.
SSL_PROVIDER=stub

# Cloudflare for SaaS — only needed when SSL_PROVIDER=cloudflare.
# Variable names match the official Cloudflare docs.
#   CLOUDFLARE_API_TOKEN  API token with `Zone:SSL and Certificates:Edit`
#                         (and `Zone:Zone:Read`) on the zone that hosts
#                         the platform edge. Never log this value.
#   CLOUDFLARE_ZONE_ID    Zone id for the platform's apex zone (the
#                         zone that owns the wildcard record for
#                         `*.matjar.com`). Used for every custom
#                         hostname API call.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Logging
LOG_LEVEL=info

# Session Configuration
SESSION_SECRET=your-super-secret-session-key-change-this-in-production

# Cloudinary Configuration (for image uploads)
CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret
CLOUDINARY_FOLDER=matjar

# Upload Configuration
MAX_FILE_SIZE=5242880
MAX_FILES_PER_UPLOAD=10

# Stripe Payment Integration
# Only consumed when STRIPE_ENABLED=true (see below).
STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-signing-secret

# Email (Resend)
# Set EMAIL_ENABLED=true in production to actually send mail; worker
# short-circuits to a log-only stub otherwise.
EMAIL_ENABLED=false
RESEND_API_KEY=re_your-resend-api-key
EMAIL_FROM=Matjar <noreply@matjar.com>

# Public URL of the merchant dashboard SPA. Used to build absolute
# deep-links in outbound notification emails ("View in dashboard" +
# "Manage notification preferences" footer). Leave empty in dev to fall
# back to relative paths.
PUBLIC_DASHBOARD_URL=https://app.matjar.com

# Payments.
#
# PAYMENTS_ENABLED turns on the manual payment rails (cash on delivery,
# bank transfer, Fawry, etc.) — the soft-launch default. It does NOT
# require any gateway secrets.
#
# Gateway integrations (Stripe) are parked behind their own
# per-provider flag so an operator can run manual-only without
# committing to a gateway. When `true`, it requires its
# corresponding secrets above (prod validation rejects the boot
# otherwise).
PAYMENTS_ENABLED=false
STRIPE_ENABLED=false

# Platform-admin escape hatch for the synchronous export endpoint in
# production. Off by default — operators opt in per-deploy for one-off
# data pulls. In dev/CI the sync endpoint works regardless.
ALLOW_SYNC_EXPORT=

# Upload provider switch. Leave unset for local-disk uploads in dev;
# set to `cloudinary` in production (requires CLOUDINARY_* above).
UPLOAD_PROVIDER=

# Platform canonical domain. Single source of truth — DOMAIN_SUFFIX /
# BASE_DOMAIN are kept as back-compat aliases.
PLATFORM_DOMAIN=matjar.com

# Legacy alias for PUBLIC_DASHBOARD_URL. Config reads PUBLIC_DASHBOARD_URL
# first and falls back to this. Prefer PUBLIC_DASHBOARD_URL in new deploys;
# kept here for back-compat with older env files.
DASHBOARD_URL=

# Sentry error tracking.
#
# SENTRY_DSN                   Public DSN. When unset, Sentry is fully
#                              disabled — the app logs "Sentry disabled"
#                              once at boot and every capture is a no-op.
# SENTRY_ENVIRONMENT           Environment tag. Defaults to NODE_ENV.
# SENTRY_RELEASE               Release identifier. On Render this is
#                              automatically populated by RENDER_GIT_COMMIT
#                              if unset. Only matters when source maps are
#                              uploaded.
# SENTRY_TRACES_SAMPLE_RATE    Performance tracing sample rate, 0..1.
#                              Defaults to 0.1 in prod, 1.0 elsewhere.
SENTRY_DSN=
SENTRY_ENVIRONMENT=
SENTRY_RELEASE=
SENTRY_TRACES_SAMPLE_RATE=

# Dashboard + platform-admin (Vite) Sentry.
#
# The `VITE_` prefix is required for Vite to expose values to the client
# bundle. Use the same DSN pattern as the backend but a separate Sentry
# project so browser traffic is isolated from backend traffic in the UI.
# Leave unset to fully disable client-side tracking.
VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=
VITE_SENTRY_RELEASE=

# Sentry source-map upload (optional, build-time only).
# SENTRY_AUTH_TOKEN                  Auth token with `project:releases`
#                                    scope. When unset, the Vite plugin
#                                    skips upload and maps stay local.
# SENTRY_ORG                         Target org slug.
# SENTRY_PROJECT                     Dashboard project slug.
# SENTRY_PROJECT_PLATFORM_ADMIN      Platform-admin project slug (kept
#                                    separate so the two SPAs upload to
#                                    distinct Sentry projects).
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_PROJECT_PLATFORM_ADMIN=

# Automated backups (mongodump → gzip → Cloudflare R2).
#
# Set BACKUP_ENABLED=true in production. When unset or "false" the
# worker's daily cron still ticks at 03:00 UTC but short-circuits before
# spawning mongodump — safe for dev/staging without a configured bucket.
#
# Required when BACKUP_ENABLED=true:
#   BACKUP_S3_ENDPOINT          R2 endpoint, e.g.
#                               https://ACCOUNT_ID.r2.cloudflarestorage.com
#   BACKUP_S3_ACCESS_KEY_ID     R2 access key id (generated per bucket
#                               with Object:Read+Write scope)
#   BACKUP_S3_SECRET_ACCESS_KEY R2 secret access key
#   BACKUP_S3_BUCKET            R2 bucket name (e.g. matjar-backups-prod)
#   BACKUP_S3_REGION            default "auto" — R2 ignores the value but
#                               the AWS SDK requires a non-empty region
#
# Retention: 30 most recent daily snapshots + 12 monthly snapshots
# (first backup of each month). Older archives are pruned automatically
# after each successful backup run.
#
# Restore verification: `npm run backup:verify` downloads the latest
# backup from R2, restores into a throwaway DB on RESTORE_DB_URI, compares
# doc counts, then drops the throwaway DB. For local-only verification,
# first create a local archive with mongodump and run:
#   npm run backup:verify -- --archive-path /tmp/matjar.archive.gz
# RESTORE_DB_URI should point at a disposable MongoDB target, for example
# Docker Mongo on localhost:27018. Operator-initiated; no cron yet.
#
# mongodump CLI must be on PATH in the worker image. It is NOT bundled
# with the mongo driver — install MongoDB Database Tools
# (https://www.mongodb.com/docs/database-tools/) in the Dockerfile or
# run backups from a separate Render service built on an image that
# ships the tools preinstalled.
BACKUP_ENABLED=false
BACKUP_S3_ENDPOINT=
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=
BACKUP_S3_BUCKET=
BACKUP_S3_REGION=auto
RESTORE_DB_URI=mongodb://localhost:27018

# Docker Compose local-dev credentials.
# Only used by docker-compose for local dev — runtime code never reads
# these. docker-compose.yml uses the `:?` form so it will refuse to
# start if the password vars are unset, forcing the operator to pick a
# real value rather than silently defaulting to "admin123".
MONGO_ROOT_USERNAME=admin
MONGO_ROOT_PASSWORD=
MONGO_EXPRESS_USERNAME=admin
MONGO_EXPRESS_PASSWORD=

# Legacy alias for DB_URI, read only by standalone seed scripts under
# scripts/ (e.g. seed-payment-methods.js) that bypass config/ and read
# raw env. The app itself requires DB_URI at boot — config validation
# rejects a missing DB_URI regardless of MONGODB_URI. Prefer DB_URI in
# new deploys; this is kept for back-compat with older env files and the
# Mongoose "standard" env name.
MONGODB_URI=

# scripts/migrate-to-shared-db.js — one-shot migration from the legacy
# tenant-per-database topology to the shared-DB model. Only set these
# when actually running the migration:
#   OLD_ADMIN_DB_URI  Legacy admin DB holding the tenant registry.
#   DRY_RUN           "false" to actually execute writes (default is a
#                     dry run so an accidental invocation prints the
#                     plan without touching data).
OLD_ADMIN_DB_URI=
DRY_RUN=

# ---------------------------------------------------------------------
# Frontend (Vite) configuration
# ---------------------------------------------------------------------
# These are injected into the browser bundle at build time via Vite's
# `import.meta.env`. Only variables prefixed with VITE_ are exposed.
# Set per-SPA via their own `.env` files (dashboard/.env, etc.) OR here
# if you're running everything from the repo root in dev.
#
# VITE_API_BASE_URL     Dashboard SPA + useNotifications hook — path to
#                       the backend API. Defaults to "/api" (works when
#                       the SPA is served from the same origin). Set to
#                       an absolute URL for split-domain deploys.
# VITE_API_URL          Storefront themes — backend API for storefront
#                       endpoints. Defaults to "/api".
# VITE_STOREFRONT_URL   Storefront themes — storefront endpoints mount
#                       point. Defaults to "/storefront".
# VITE_SENTRY_*         See the Sentry section above.
VITE_API_BASE_URL=
VITE_API_URL=
VITE_STOREFRONT_URL=
