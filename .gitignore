node_modules
.env
.env.*
!.env.example

# Dev-only auto-generated Web Push VAPID keypair. Production MUST set
# VAPID_PUBLIC_KEY / VAPID_PRIVATE_KEY env vars instead of relying on this.
.vapid.json

# Built theme artifacts — source of truth is each theme's
# `src/theme.manifest.ts`; dist/ is produced by the Vite build in CI
# (or `bash scripts/build-themes.sh` locally). Keeping it out of git
# avoids noisy diffs and prevents a stale prebuilt bundle from
# overriding a freshly-written source manifest.
storefront-themes/*/dist
storefront-themes/*/node_modules
dashboard/dist/
platform-admin/dist/

# Stray generated frontend bundles that were accidentally placed under
# schemas/ during earlier work. They are not backend schema source.
schemas/test*.js

# macOS metadata
.DS_Store

# Editor / local tool state — user-specific, not meant to be committed
.cursor/
.claude/

# Playwright MCP run artifacts (console logs, page snapshots)
.playwright-mcp/

# Stale local env placeholder from early in the project
.examlpe.env

# Uploads directory — runtime-written, should not be committed
public/uploads/

# Ad-hoc dev harnesses under scripts/ — anything prefixed `test-` is a
# one-off used to poke a flow locally, not a real test (real tests live
# under tests/). Keep them out of git so the scripts/ dir stays a
# curated set of operational tooling.
scripts/test-*.js

# NOTE: `archive/` is intentionally NOT ignored — it holds historical
# scratch files, design references, and test outputs that the user
# wants to keep. Uncomment the next line if you decide to exclude it.
archive/

docs/
