# API Configuration
VITE_API_BASE_URL=http://localhost:3000/api

# Sentry browser SDK — all three vars are optional. Leave VITE_SENTRY_DSN
# unset to fully disable client-side error tracking.
VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=
VITE_SENTRY_RELEASE=

# Source-map upload (build-time only; never exposed to the browser).
# Leave SENTRY_AUTH_TOKEN unset to skip the upload step — the Vite
# plugin becomes a no-op and no sourcemaps are emitted to disk.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
